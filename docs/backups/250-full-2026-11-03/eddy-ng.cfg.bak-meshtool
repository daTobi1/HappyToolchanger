# ============================================================================
# eddy-ng.cfg – BTT Eddy Duo via CAN bus
#
# Ersteinrichtung (Basis):
#   EDDY_CAL_STEP1   Setup         (manuelles Z, dann ACCEPT + SAVE_CONFIG)
#   EDDY_CAL_STEP2   Drive Current (automatisch, ~2 min)
#   EDDY_CAL_STEP3   Tap Threshold (automatisch, ~2 min)
#   EDDY_CAL_STEP4   Verify        (Verifikation)
# Erweitert:
#   EDDY_CAL_STEP5   Temp Comp     (Temperaturkompensation, 30-60 min)
#   EDDY_CAL_STEP6   Axis Twist    (~6 min)
#   EDDY_CAL_STEP7   Backlash      (~2 min)
# ============================================================================

[include calibrate_macros.cfg]

# ── Eddy MCU (CAN) ────────────────────────────────────────────────────────
[mcu eddy]
canbus_uuid: 92d72792cb36

# ── Eddy-NG Probe ─────────────────────────────────────────────────────────
[probe_eddy_ng my_eddy]
sensor_type: btt_eddy
i2c_mcu: eddy
i2c_bus: i2c0f
x_offset: 0.0
y_offset: 16.0

# Tap-Erkennung
tap_mode: wma
# Butter-Filter
#tap_butter_lowcut: 5.0
#tap_butter_highcut: 25.0
#tap_butter_order: 2
tap_speed: 3.0
tap_start_z: 3.0
tap_target_z: -2.000

# Tap-Sampling
tap_samples: 5
tap_max_samples: 40
tap_samples_stddev: 0.005
tap_adjust_z: 0.000

# Scanning / Bed Mesh
scan_sample_time: 0.100
scan_sample_time_delay: 0.050
mesh_path: snake
mesh_direction: x
mesh_runs: 1
mesh_height: 3.0

# Z Homing
home_trigger_height: 2.0

# Geschwindigkeiten
probe_speed: 5.0
lift_speed: 10.0
move_speed: 50.0

# Kalibrierung
calibration_z_max: 15.0
calibration_points: 150

# Debug (nach Ersteinrichtung auf False setzen)
debug: True

# ── Temperaturueberwachung ─────────────────────────────────────────────────
[temperature_sensor btt_eddy_mcu]
sensor_type: temperature_mcu
sensor_mcu: eddy
min_temp: 10
max_temp: 100

[temperature_sensor btt_eddy]
sensor_type: Generic 3950
sensor_pin: eddy:gpio26

# ── Bed Mesh (250mm Drucker) ─────────────────────────────────────────────
[bed_mesh]
zero_reference_position: 125, 115
speed: 200
horizontal_move_z: 3.5
mesh_min: 30, 30
mesh_max: 220, 230
probe_count: 10, 10
adaptive_margin: 10
algorithm: bicubic
fade_start: 0.6
fade_end: 10.0

# ── Quad Gantry Level (250mm Drucker) ─────────────────────────────────────
[quad_gantry_level]
gantry_corners:
   -60,-10
   310, 320
points:
  20,30
  20,230
  230,230
  230,30
speed: 200
horizontal_move_z: 3
max_adjust: 60
retries: 10
retry_tolerance: 0.006


# ============================================================================
# Makros
# ============================================================================

# ── QGL Wrapper: 2-stufig (coarse + fine) ─────────────────────────────────
[gcode_macro QUAD_GANTRY_LEVEL]
description: 2-stufiges QGL. COARSE_PROBE/FINE_PROBE=tap|eddy. Liest Tool-Settings aus _Tn_QGL.
rename_existing: _QUAD_GANTRY_LEVEL
variable_coarse_probe: "tap"
variable_fine_probe: "tap"
gcode:
  INITIALIZE_TOOLCHANGER
  {% set coarse_z   = params.COARSE_Z|default(5.0)|float %}
  {% set fine_z     = params.FINE_Z|default(2.0)|float %}
  {% set coarse_tol = params.COARSE_TOL|default(0.25)|float %}
  {% set fine_tol   = params.FINE_TOL|default(0.0075)|float %}
  {% set coarse_r   = params.COARSE_RETRIES|default(10)|int %}
  {% set fine_r     = params.FINE_RETRIES|default(10)|int %}

  # Probe-Auswahl: Parameter > Tool-Setting (_Tn_QGL) > QGL-Default
  {% set tn = printer.toolchanger.tool_number|default(0)|int %}
  {% set tool_macro = "_T" ~ tn|string ~ "_QGL" %}
  {% if "gcode_macro " ~ tool_macro in printer %}
    {% set tool_qgl = printer["gcode_macro " ~ tool_macro] %}
    {% set cp = params.COARSE_PROBE|default(tool_qgl.coarse_probe)|lower %}
    {% set fp = params.FINE_PROBE|default(tool_qgl.fine_probe)|lower %}
  {% else %}
    {% set cp = params.COARSE_PROBE|default(printer["gcode_macro QUAD_GANTRY_LEVEL"].coarse_probe)|lower %}
    {% set fp = params.FINE_PROBE|default(printer["gcode_macro QUAD_GANTRY_LEVEL"].fine_probe)|lower %}
  {% endif %}

  {action_respond_info("QGL mit T%d: coarse=%s, fine=%s" % (tn, cp, fp))}

  DETECT_ACTIVE_TOOL_PROBE

  {% if params.RAW|default(0)|int == 1 %}
    {% if cp == "tap" %}
      SET_ACTIVE_Z_PROBE PROBE=none
    {% else %}
      APPLY_TOOL_PROBE_FOR OP=qgl
    {% endif %}
    _QUAD_GANTRY_LEVEL
    APPLY_TOOL_PROBE_FOR OP=mesh
  {% else %}
    {% set homed = printer.toolhead.homed_axes %}
    {% if 'x' not in homed or 'y' not in homed %}
      G28 X Y
    {% endif %}

    {% if 'z' in homed %}
      G90
      G0 Z{coarse_z} F1000
    {% endif %}

    # -- Coarse pass --
    {% if cp == "tap" %}
      SET_ACTIVE_Z_PROBE PROBE=none
    {% else %}
      APPLY_TOOL_PROBE_FOR OP=qgl
    {% endif %}
    M117 QGL coarse ({cp})
    _QUAD_GANTRY_LEVEL HORIZONTAL_MOVE_Z={coarse_z} RETRY_TOLERANCE={coarse_tol} RETRIES={coarse_r}

    G90
    G0 Z{coarse_z} F1000

    # -- Fine pass --
    {% if fp != cp %}
      {% if fp == "tap" %}
        SET_ACTIVE_Z_PROBE PROBE=none
      {% else %}
        APPLY_TOOL_PROBE_FOR OP=qgl
      {% endif %}
    {% endif %}
    M117 QGL fine ({fp})
    _QUAD_GANTRY_LEVEL HORIZONTAL_MOVE_Z={fine_z} RETRY_TOLERANCE={fine_tol} RETRIES={fine_r}

    M117 QGL done
  {% endif %}

  # Probe fuer Bed Mesh wiederherstellen (tool-eigene, sonst Tap)
  APPLY_TOOL_PROBE_FOR OP=mesh

[gcode_macro HOMING_ROUTINE]
description: Vollstaendiges Homing mit dem montierten Tool: XY -> QGL -> Clean -> Nozzle-Zero -> Mesh
gcode:
  INITIALIZE_TOOLCHANGER
  ENSURE_TOOL_MOUNTED

  {% set clean = params.CLEAN|default(0)|int %}
  {% set clean_temp = params.CLEAN_TEMP|default(260)|float %}

  # 1) Home XYZ. G28 Z laeuft ueber die Probe des aktiven Tools und legt
  #    Z=0 anhand deren z_offset bereits auf den Nozzle-Kontakt.
  SET_GCODE_OFFSET Z=0
  G28
  G90
  DETECT_ACTIVE_TOOL_PROBE

  # 2) QGL (2-stufig, Probe-Wahl pro Tool via _Tn_QGL)
  QUAD_GANTRY_LEVEL

  # 3) Nozzle reinigen vor dem Tap (sauber + kein Ooze)
  {% if clean != 0 %}
    CLEAN_NOZZLE TEMP={clean_temp}
  {% endif %}

  # 4) Feines Z ueber Nozzle-Touch des montierten Tools und alle
  #    gcode_z_offsets darauf umreferenzieren. Damit drucken alle Koepfe
  #    auf einer Hoehe, egal welches Tool gehomed hat.
  #    NOZZLE_ZERO faehrt selbst zur Bettmitte und waehlt die Probe
  #    (Eddy-Tap oder mechanischer Tap) anhand der Tool-Config.
  NOZZLE_ZERO
  G0 Z3 F5000

  # 5) Bed Mesh mit der Probe dieses Tools
  _BED_MESH_AUTO

  # 6) Zurueck zur Mitte
  {% set axmin = printer.toolhead.axis_minimum %}
  {% set axmax = printer.toolhead.axis_maximum %}
  {% set cx = (((0.0 if axmin.x < 0 else axmin.x)|float + axmax.x|float) / 2.0)|float %}
  {% set cy = (((0.0 if axmin.y < 0 else axmin.y)|float + axmax.y|float) / 2.0)|float %}
  G1 X{ '%.3f' % cx } Y{ '%.3f' % cy } F2000

[gcode_macro _BED_MESH_AUTO]
description: Bed Mesh mit der Probe des aktiven Tools - Eddy-Scan wenn vorhanden, sonst getastet
gcode:
  # Wird als eigenes Kommando gerendert, damit der Tool-Status zum
  # Zeitpunkt des Aufrufs gilt und nicht beim Rendern der aufrufenden Makros.
  {% set mesh_probe = printer.tool_probe_endstop.z_probe_mesh %}
  BED_MESH_CLEAR
  {% if mesh_probe %}
    APPLY_TOOL_PROBE_FOR OP=mesh
    { action_respond_info("Bed Mesh: rapid_scan mit %s" % mesh_probe) }
    BED_MESH_CALIBRATE METHOD=rapid_scan
  {% else %}
    SET_ACTIVE_Z_PROBE PROBE=none
    { action_respond_info("Bed Mesh: getastet (Tap) - kein Scanning-Probe an diesem Tool") }
    BED_MESH_CALIBRATE
  {% endif %}

# ------------------------------ Emergency Homing -----------------------------
[gcode_macro EMERGENCY_HOME]
description: Notfall-Homing ohne T0 - nutzt Tap des aktiven Tools fuer grobes Z/QGL
variable_tap_z_safety_offset: 0.5
gcode:
    INITIALIZE_TOOLCHANGER

    {% set current_tool = printer.toolchanger.tool_number|int %}

    {% if current_tool == 0 %}
        M118 T0 geladen - starte normales Homing
        HOMING_ROUTINE
    {% else %}
        M118 ========================================
        M118 EMERGENCY HOME: T{current_tool} aktiv
        M118 Nutze Tap-Sensor fuer grobes Homing
        M118 ========================================

        {% set saved_vars = printer.save_variables.variables %}
        {% set tap_offset = saved_vars.tap_z_offset|default(0.0)|float %}
        {% set safety = tap_z_safety_offset|float %}

        SET_GCODE_OFFSET Z=0

        # 1) Home X/Y (funktioniert mit jedem Tool)
        M118 [1/5] Home X/Y...
        G28 X Y
        DETECT_ACTIVE_TOOL_PROBE

        # 2) Grob-Z via Tap
        M118 [2/5] Grobes Z-Homing via Tap...
        SET_KINEMATIC_POSITION Z=270
        G90
        G0 X125 Y115 F6000
        PROBE SPEED=3 SAMPLES=1
        G91
        G0 Z2 F1000
        G90
        SET_KINEMATIC_POSITION Z={ 5.0 + safety + tap_offset }
        M118 Z grob gesetzt (Safety={safety}, Tap-Offset={tap_offset})

        # 3) Grobe QGL (lockere Toleranz, mit Tap)
        M118 [3/5] Grobe QGL...
        SET_ACTIVE_Z_PROBE PROBE=none
        G0 Z10 F1000
        _QUAD_GANTRY_LEVEL HORIZONTAL_MOVE_Z=10 RETRY_TOLERANCE=0.15 RETRIES=5

        # 4) T0 aufnehmen
        M118 [4/5] Wechsel zu T0...
        G0 Z10 F1000
        T0

        # 5) Praezises Homing mit Eddy
        M118 [5/5] Praezises Homing mit Eddy-NG...
        HOMING_ROUTINE

        M118 ========================================
        M118 EMERGENCY HOME abgeschlossen
        M118 ========================================
    {% endif %}

# ------------------------------ Tap-Offset Kalibrierung ----------------------
[gcode_macro CALIBRATE_TAP_OFFSET]
description: Kalibriert den Z-Offset zwischen Eddy-Tap und mechanischem Tap. T0 muss geladen sein.
gcode:
    {% set test_tool = params.TOOL|default(1)|int %}
    {% set samples = params.SAMPLES|default(5)|int %}

    # Voraussetzung: T0 muss geladen sein
    ENSURE_TOOL_MOUNTED
    {% if printer.toolchanger.tool_number|int != 0 %}
        M118 FEHLER: T0 muss geladen sein! Aktuell: T{printer.toolchanger.tool_number}
    {% else %}
        # 1) Praezises Homing mit Eddy
        M118 [1/3] Praezises Homing mit Eddy-NG...
        HOMING_ROUTINE
        M118 Eddy-Referenz: Z=0 ist Bettoberflaeche

        # 2) Wechsel zum Test-Tool
        M118 [2/3] Wechsel zu T{test_tool} fuer Tap-Messung...
        G90
        G0 X125 Y115 Z10 F6000
        T{test_tool}

        # 3) Tap-Messung
        M118 [3/3] Tap-Messung mit T{test_tool} ({samples} Samples)...
        M118 HINWEIS: Nach PROBE den Z-Wert aus dem Log ablesen.
        M118 Der Wert ist der Tap-Offset (sollte nahe 0 sein).
        M118 Speichern mit: SAVE_VARIABLE VARIABLE=tap_z_offset VALUE=<wert>
        G90
        G0 X125 Y115 Z10 F6000
        PROBE SPEED=3 SAMPLES={samples}
        M118 Kalibrierung abgeschlossen - Z-Wert oben ablesen und speichern.

        # Zurueck zu T0
        G0 Z10 F1000
        T0
    {% endif %}

# ── Utility ───────────────────────────────────────────────────────────────
[gcode_macro ENSURE_TOOL_MOUNTED]
description: Laedt T0, falls kein Tool aktiv ist
gcode:
  {% if not printer.toolhead.extruder %}
    T0
  {% endif %}

# ── Tool Z Offset Calibration ──────────────────────────────────────────────
# Uses Eddy (T0) as high-precision reference, then probes each tool's Tap.
# Usage: CALIBRATE_TOOL_Z_OFFSETS [SAMPLES=5] [APPLY=1]
[tool_z_calibrate]
probe_x: 125
probe_y: 115
samples: 5
